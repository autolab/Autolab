<% @title = "SSH Keys - #{@user.display_name}" %>

<h4>SSH Key Management</h4>
<p>Manage SSH public keys for user: <strong><%= @user.display_name %></strong> (<%= @user.email %>)</p>

<% unless @user.staff? || current_user.administrator? %>
  <div class="error" style="padding: 1em; margin: 1em 0;">
    <p><strong>Access Restricted:</strong> SSH key management is only available for course instructors and teaching assistants.</p>
    <p>Only users who are instructors or TAs in at least one course can add SSH keys to access the system.</p>
  </div>
<% else %>
  <% if @user == current_user || current_user.administrator? %>
    <% username = UnixGroupManager.login_from_email(@user.email) %>
    <% if username %>
      <p><strong>Unix Username:</strong> <code><%= username %></code></p>
      <% hostname = request.host || "autolab.example.com" %>
      <p>After adding an SSH key, you can SSH into the system using:<br>
         <code>ssh <%= username %>@<%= hostname %></code></p>
    <% else %>
      <p class="warning">Unix user account not yet created. It will be created automatically when you add your first SSH key or when you are added as staff to a course.</p>
    <% end %>

    <div class="card-panel light-blue lighten-5" style="margin-top: 1.5em;">
      <strong>Need to generate a key?</strong>
      <p>If you don’t already have an SSH key, run these commands on your computer:</p>
      <pre style="margin-bottom: 0;">
ssh-keygen -t ed25519-autolab -C "<%= @user.email %>"
cat ~/.ssh/id_ed25519-autolab.pub

# or, if you prefer RSA (longer key):
ssh-keygen -t rsa-autolab -b 4096 -C "<%= @user.email %>"
cat ~/.ssh/id_rsa-autolab.pub
      </pre>
      <p>Copy the output of the last command and paste it into the form below.</p>
    </div>
  <% end %>
<% end %>

<% if @user.staff? || current_user.administrator? %>
  <hr>

  <h5>Add New SSH Key</h5>
  <%= form_with url: create_ssh_key_user_path(@user), method: :post, local: true do |f| %>
    <div class="input-field">
      <%= f.text_area :public_key, class: "materialize-textarea", 
                      placeholder: "ssh-rsa AAAA... your-email@example.com\n\nPaste your SSH public key here. It should start with 'ssh-rsa', 'ssh-ed25519', or 'ecdsa-sha2-nistp256'.", 
                      rows: 5, required: true %>
      <label for="public_key">SSH Public Key</label>
    </div>
    <%= f.submit "Add SSH Key", class: "btn primary" %>
  <% end %>

  <hr>

  <h5>Current SSH Keys</h5>
  <% if @ssh_keys.empty? %>
    <p>No SSH keys configured yet.</p>
  <% else %>
  <table class="striped">
    <thead>
      <tr>
        <th>Key Type</th>
        <th>Comment</th>
        <th>Fingerprint</th>
        <th>Added</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @ssh_keys.each do |ssh_key| %>
        <tr>
          <td><code><%= ssh_key.key_type %></code></td>
          <td><%= ssh_key.comment || "(no comment)" %></td>
          <td><code style="font-size: 0.85em;"><%= ssh_key.fingerprint&.first(16) %>...</code></td>
          <td><%= ssh_key.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td>
            <%= link_to destroy_ssh_key_user_path(@user, ssh_key_id: ssh_key.id), 
                        method: :delete, 
                        data: { confirm: "Are you sure you want to remove this SSH key?" },
                        class: "btn-small" do %>
              Remove
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% end %>
<% end %>

<hr>

<p><%= link_to "← Back to User Profile", user_path(@user), class: "btn" %></p>
