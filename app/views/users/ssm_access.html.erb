<% iam_user_created = @user.iam_user_created_at.present? %>

<h4>IAM & UNIX User Management</h4>

<p>
  Manage the AWS IAM user and corresponding Linux account for
  <strong><%= @user.display_name %></strong>
  (<%= @user.email %>).
</p>

<div class="alert alert-info">
  <h5>About account access</h5>

  <% if iam_user_created %>
    <p>
      Your AWS IAM user and Linux account have already been created.
    </p>

    <p>
      You can regenerate your AWS access key below.
      <strong>The secret access key is only shown once,</strong>
      so make sure to save it before leaving this page.
    </p>
  <% else %>
    <p>
      This will create an AWS IAM user and a Linux user on the configured
      EC2 instance.
    </p>

    <p>
      <strong>An AWS access key will also be generated.</strong>
      The secret access key is only available when the account is first
      created, so make sure to save it before leaving this page.
    </p>
  <% end %>
</div>

<div class="form-group">
  <label>Username</label>

  <p class="form-control-static">
    <strong><%= @username %></strong>
  </p>

  <p class="help-block">
    This username is used for both the AWS IAM user and Linux account.
  </p>
</div>

<div
  id="creation-error"
  class="alert alert-danger"
  style="display: none;">
</div>

<button
  id="aws-action-button"
  type="button"
  class="btn btn-danger"
  data-mode="<%= iam_user_created ? "regenerate" : "create" %>"
  data-url="<%= if iam_user_created
                  regenerate_iam_access_key_user_path(@user)
                else
                  create_iam_unix_user_user_path(@user)
                end %>">
  <%= iam_user_created ? "REGENERATE ACCESS KEY" : "CREATE USER" %>
</button>

<div id="creation-status" style="display: none;">
  <h5>Account Status</h5>

  <div class="alert alert-info">
    <strong>Status:</strong>
    <span id="status-text">Starting...</span>
  </div>
</div>

<div
  id="credentials-panel"
  class="alert alert-warning"
  style="display: none;">

  <h5>AWS Access Key Created</h5>

  <p>
    <strong>Save these credentials now.</strong>
    AWS will not display the secret access key again.
    If you lose it, you will need to generate a new access key.
  </p>

  <div class="form-group">
    <label>Access Key ID</label>

    <div>
      <code id="access-key-id"></code>

      <button
        class="btn btn-default btn-sm"
        type="button"
        onclick="copyText('access-key-id')">
        COPY
      </button>
    </div>
  </div>

  <div class="form-group">
    <label for="secret-access-key">Secret Access Key</label>

    <div class="input-group">
      <input
        id="secret-access-key"
        class="form-control"
        type="password"
        autocomplete="off"
        readonly>

      <span class="input-group-btn">
        <button
          id="show-secret-button"
          class="btn btn-default"
          type="button"
          onclick="toggleSecret()">
          SHOW
        </button>

        <button
          class="btn btn-default"
          type="button"
          onclick="copyValue('secret-access-key')">
          COPY
        </button>
      </span>
    </div>
  </div>
</div>

<div
  id="ssm-instructions"
  style="<%= iam_user_created ? "" : "display: none;" %>">

  <hr>

  <h5>Connect Using AWS SSM</h5>

  <p>
    First configure the AWS CLI using the access key shown above:
  </p>

  <pre><code>aws configure</code></pre>

  <p>
    Then connect to the EC2 instance using AWS Systems Manager:
  </p>

  <pre><code>aws ssm start-session --target <%= @instance_id %></code></pre>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const actionButton = document.getElementById("aws-action-button");

        actionButton.addEventListener("click", function() {
            startAwsOperation();
        });

        const existingStatus = "<%= @user.aws_job_status.to_s %>";

        if (existingStatus === "pending" || existingStatus === "in_progress") {
            actionButton.disabled = true;

            document.getElementById("creation-status").style.display = "block";
            document.getElementById("status-text").innerText =
                "Operation in progress...";

            pollProvisionStatus();
        }
    });

    async function startAwsOperation() {
        const button = document.getElementById("aws-action-button");
        const mode = button.dataset.mode;

        button.disabled = true;
        button.innerText =
            mode === "create" ? "CREATING..." : "REGENERATING...";

        document.getElementById("creation-error").style.display = "none";
        document.getElementById("creation-status").style.display = "block";

        document.getElementById("status-text").innerText =
            mode === "create"
                ? "Starting account creation..."
                : "Starting access key regeneration...";

        try {
            const response = await fetch(button.dataset.url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-CSRF-Token":
                    document.querySelector('meta[name="csrf-token"]').content
                }
            });

            const data = await response.json();

            console.log(data);

            if (!response.ok) {
                throw new Error(
                    data.error || "Failed to start AWS operation."
                );
            }

            if (data.accessKey) {
                showCredentials(data.accessKey);
            }

            if (data.statusId === 2) {
                operationFinished(mode);
                return;
            }

            if (data.statusId === 255) {
                operationFailed(
                    mode,
                    data.statusMsg || "AWS operation failed."
                );
                return;
            }

            pollProvisionStatus();

        } catch (error) {
            operationFailed(mode, error.message);
        }
    }

    async function pollProvisionStatus() {
        const button = document.getElementById("aws-action-button");
        const mode = button.dataset.mode;

        try {
            const response = await fetch(
                "<%= iam_unix_user_status_user_path(@user) %>"
            );

            const data = await response.json();

            console.log(data);

            if (!response.ok) {
                throw new Error(
                    data.error || "Failed to retrieve AWS job status."
                );
            }

            if (data.accessKey) {
                showCredentials(data.accessKey);
            }

            document.getElementById("status-text").innerText =
                data.statusMsg;

            if (data.statusId === 2) {
                operationFinished(mode);
                return;
            }

            if (data.statusId === 255) {
                operationFailed(
                    mode,
                    data.statusMsg || "AWS operation failed."
                );
                return;
            }

            setTimeout(pollProvisionStatus, 2000);

        } catch (error) {
            operationFailed(mode, error.message);
        }
    }

    function operationFinished(mode) {
        const button = document.getElementById("aws-action-button");

        if (mode === "create") {
            document.getElementById("status-text").innerText =
                "Account created successfully.";

            document.getElementById("ssm-instructions").style.display =
                "block";

            // The user now exists, so future clicks should regenerate the key.
            button.dataset.mode = "regenerate";
            button.dataset.url =
                "<%= regenerate_iam_access_key_user_path(@user) %>";

            button.innerText = "REGENERATE ACCESS KEY";
            button.disabled = false;

        } else {
            document.getElementById("status-text").innerText =
                "Access key regenerated successfully.";

            button.innerText = "REGENERATE ACCESS KEY";
            button.disabled = false;
        }
    }

    function operationFailed(mode, message) {
        document.getElementById("status-text").innerText =
            mode === "create"
                ? "Account creation failed."
                : "Access key regeneration failed.";

        const errorBox = document.getElementById("creation-error");

        errorBox.innerText = message;
        errorBox.style.display = "block";

        const button = document.getElementById("aws-action-button");

        button.innerText =
            mode === "create"
                ? "CREATE USER"
                : "REGENERATE ACCESS KEY";

        button.disabled = false;
    }

    function showCredentials(accessKey) {
        document.getElementById("access-key-id").textContent =
            accessKey.accessKeyId;

        document.getElementById("secret-access-key").value =
            accessKey.secretAccessKey;

        document.getElementById("credentials-panel").style.display =
            "block";
    }

    function toggleSecret() {
        const field =
            document.getElementById("secret-access-key");

        const button =
            document.getElementById("show-secret-button");

        if (field.type === "password") {
            field.type = "text";
            button.innerText = "HIDE";
        } else {
            field.type = "password";
            button.innerText = "SHOW";
        }
    }

    async function copyText(id) {
        const value =
            document.getElementById(id).textContent;

        await navigator.clipboard.writeText(value);
    }

    async function copyValue(id) {
        const value =
            document.getElementById(id).value;

        await navigator.clipboard.writeText(value);
    }
</script>
