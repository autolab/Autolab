<% @title = "Manage AMI Images" %>

<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "ami_image" %>
  <%= stylesheet_link_tag "style" %>
<% end %>

<h3>Manage AMI Images</h3>
<hr>

<div class="row buttons-row">
  <%= link_to 'New AMI Image', new_course_ami_image_path(@course), { class: "btn" } %>
</div>
<table class="prettyBorder">
  <colgroup>
    <col style="width: 20%">
    <col >
    <col style="width: 80px">
    <col style="width: 180px">
  </colgroup>
  <thead>
    <tr>
      <th>Name</th>
      <th>Packages</th>
      <th class="center-column">Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
  <% if @ami_images.empty? %>
    <tr>
      <td colspan="2">There are currently no AMI images</td>
    </tr>
  <% else %>
    <% @ami_images.each do |image| %>
      <tr>
        <td>
          <div>
            <div class="ami-name"><%= image.name %></div>
            <div class="ami-id">
              <%= if image.ami_id.nil? then "Wait for AMI Build" else image.ami_id end%>
            </div>
          </div>
        </td>
        <td>
          <% image.ami_packages.each do |package| %>
            <span class="pkg-chip">
              <%= package.name %>
            </span>
          <% end %>
        </td>
        <td class="status-cell">
          <div class="center-column">
            <% if image.status == 1 %>
              <div class="hourglass-icon">
                <i class="material-icons status-icon">hourglass_bottom</i>
              </div>
            <% elsif image.status == 2%>
              <div class="building-icon">
                <i class="material-icons status-icon">construction</i>
              </div>
            <% elsif image.status == 0 %>
              <div class="success-icon">
                <i class="material-icons status-icon">done_all</i>
              </div>
            <% else %>
              <div class="error-icon">
                <i class="material-icons status-icon">error_outline</i>
              </div>
            <% end %>
          </div>
        </td>
        <td class="actions-cell">
          <div>
            <%= link_to "<i class='material-icons'>edit</i>".html_safe, edit_course_ami_image_path(@course, image.id),
                        { title: "View this AMI image", class: "btn small" } %>
            Edit
          </div>
          <div>
            <%= link_to "<i class='material-icons'>delete</i>".html_safe, course_ami_image_path(@course, image.id),
                        { method: :delete, title: "Delete this AMI image", class: "btn small" } %>
            Delete
          </div>
        </td>
      </tr>
    <% end %>
  <% end %>
  </tbody>
</table>

<br>
