<% @title = "AMI Builder" %>

<div class="section">
  <h4>AMI Builder</h4>
  <%= form_with url: { action: :create_ami }, builder: FormBuilderWithDateTimeInput do |f| %>
    <%= f.text_field :image_name,
                     value: @ami_image.name,
                     pattern: "^[a-z0-9](_{0,2}[a-z0-9])*(/[a-z0-9](_{0,2}[a-z0-9])*)?$",
                     help_text: "Name of AMI image. Any existing image with the same name will be overwritten." %>
    <h5>Packages</h5>
    <table class="bordered responsive-table">
      <thead>
      <tr>
        <th data-field="package-name">Name</th>
        <th data-field="package-version">Version</th>
        <th data-field="options">Options</th>
      </tr>
      </thead>
      <tbody>
      <% for package in @ami_image.packages do %>
        <% parsed = @ami_image.parse_package(package) %>
        <tr>
          <td>
            <%= parsed[:name] %>
          </td>
          <td><%= parsed[:version]  %></td>
          <td>
            Todo
            <%#= link_to "<i class=\"material-icons left\">delete</i>".html_safe, [@course, @assessment, problem], method: :delete, class: "small", data: { confirm: "Deleting will delete all associated problem data (such as scores and annotations) and cannot be undone. Are you sure you want to delete this problem?" } %>
          </td>
        </tr>
      <% end %>
      <tr>
        <%= link_to "Add Package".html_safe, new_package_course_ami_image_path(@course, @ami_image), { class: "btn" } %>
      </tr>
      </tbody>
    </table>
    <br>
    <div class="action_buttons">
      <%= f.submit "Create AMI" %>
    </div>
  <% end %>
</div>
