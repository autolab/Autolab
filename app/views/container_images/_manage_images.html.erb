<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "container_images" %>
  <%= stylesheet_link_tag "style" %>
<% end %>

<div class="row buttons-row">
  <% if admin %>
    <%= link_to 'New Docker Image', new_admin_container_image_path, { class: "btn mr-8" } %>
    <%= link_to 'Refresh All', refresh_all_status_admin_container_images_path, { class: "btn mr-8" } %>
  <% else %>
    <%= link_to 'New Docker Image', new_course_container_image_path(course), { class: "btn mr-8" } %>
    <%= link_to 'Refresh All', refresh_all_status_course_container_images_path(course), { class: "btn mr-8" } %>
  <% end %>
</div>
<table class="prettyBorder">
  <colgroup>
    <col style="width: 20%">
    <col >
    <col style="width: 80px">
    <col style="width: 180px">
  </colgroup>
  <thead>
  <tr>
    <th>Name</th>
    <th>ECR Image Tag</th>
    <th class="center-column">Status</th>
    <th>Actions</th>
  </tr>
  </thead>
  <tbody>
  <% if container_images.empty? %>
    <tr>
      <td colspan="2">There are currently no autograder images</td>
    </tr>
  <% else %>
    <% container_images.each do |image| %>
      <tr>
        <td>
          <div>
            <div class="ami-name"><%= image.name %></div>
          </div>
        </td>
        <td>
          <% if image.image_uri.nil? %>
            Image not ready
          <% else %>
            <span class="tooltip">
              <span class="tooltip-text">
                <%= image.image_uri.split(":").last %>
              </span>
              <span class="tooltip-hover">
                <%= image.image_uri %>
              </span>
            </span>
          <% end %>
        </td>
        <td class="status-cell">
          <div class="center-column">
            <% if image.status == "draft" %>
              <div class="status-chip status-chip--draft">
                <i class="material-icons status-icon">edit</i>
                <div class="status-desc">Draft</div>
              </div>
            <% elsif image.status == "building" %>
              <div class="status-chip status-chip--building">
                <i class="material-icons status-icon">construction</i>
                <div class="status-desc">Building</div>
              </div>
            <% elsif image.status == "ready" %>
              <div class="status-chip status-chip--ready">
                <i class="material-icons status-icon">done_all</i>
                <div class="status-desc">Ready</div>
              </div>
            <% elsif image.status == "disabled" %>
              <div class="status-chip status-chip--disabled">
                <i class="material-icons status-icon">block</i>
                <div class="status-desc">Disabled</div>
              </div>
            <% else %>
              <div class="status-chip status-chip--error">
                <i class="material-icons status-icon">error</i>
                <div class="status-desc">Failed</div>
              </div>
            <% end %>
          </div>
        </td>
        <td class="actions-cell">
          <div>
            <% if admin %>
              <%= link_to "<i class='material-icons'>delete</i>".html_safe, admin_container_image_path(image.id),
                          { method: :delete, title: "Delete this Docker image", class: "btn small" } %>
            <% else %>
              <%= link_to "<i class='material-icons'>delete</i>".html_safe, course_container_image_path(course, image.id),
                          { method: :delete, title: "Delete this Docker image", class: "btn small" } %>
            <% end %>
            Delete
          </div>
          <div>
            <% if admin %>
              <%= link_to "<i class='material-icons'>text_snippet</i>".html_safe, admin_container_image_path(image.id),
                          { method: :get, title: "View Build Log", class: "btn small" } %>
            <% else %>
              <%= link_to "<i class='material-icons'>text_snippet</i>".html_safe, course_container_image_log_path(course, image.id),
                          { method: :get, title: "View Build Log", class: "btn small" } %>
            <% end %>
            View Log
          </div>
        </td>
      </tr>
    <% end %>
  <% end %>
  </tbody>
</table>

<br>