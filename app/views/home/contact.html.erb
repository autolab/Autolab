
<div class="contact-page">
  <div class="row">
    <div class="col s12">
      <h1>Contact Autolab</h1>
      <p class="lead">
        Get the right help faster by choosing the section that matches your role.
        Each section lists the best channel for the types of requests we see most often.
      </p>
    </div>
  </div>

  <div class="row">
    <div class="col s12 m6">
      <div class="card contact-card">
        <div class="card-content">
          <span class="card-title">
            <i class="material-icons contact-icon">school</i>
            Students
          </span>
          <p>
            Reach out to your course staff for anything tied to a specific class.
            They control grades, deadlines, roster changes, and extensions.
          </p>
          <ul class="contact-topics">
            <li>Regrade or rubric questions</li>
            <li>Enrollment or section changes</li>
            <li>Submission troubleshooting for a course</li>
          </ul>
        </div>
        <div class="card-action">
          <% if @student_course_contacts.present? %>
            <p class="support-label">Choose a course to email its instructors:</p>
            <ul class="collection">
              <% @student_course_contacts.each do |contact| %>
                <% course = contact[:course] %>
                <% instructors = contact[:instructors] %>
                <% subject = "[Autolab] #{course.display_name || course.name} question" %>
                <li class="collection-item">
                  <div class="contact-course">
                    <strong><%= course.display_name || course.name %></strong>
                    <%= mail_to instructors.join(","),
                                "Email instructors",
                                subject:,
                                class: "btn-flat waves-effect contact-mailto" %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="grey-text text-darken-1">
              Log in and enroll in a course to unlock instructor email shortcuts, or contact your
              professor directly using the syllabus information for your class.
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <% if @show_staff_cta %>
      <div class="col s12 m6">
        <div class="card contact-card">
          <div class="card-content">
            <span class="card-title">
              <i class="material-icons contact-icon">people</i>
              TAs &amp; Instructors
            </span>
            <p>
              Instance managers can help with Autolab infrastructure questions:
              setting up new courses, roster sync issues, or isolated platform bugs.
            </p>
            <ul class="contact-topics">
              <li>Provisioning new courses or semesters</li>
              <li>Roster uploads, LMS/LTI sync, or section mismatches</li>
              <li>Autograder crashes impacting multiple students</li>
            </ul>
          </div>
          <div class="card-action">
            <% if @instance_manager_email.present? %>
              <%= mail_to @instance_manager_email,
                          "Email instance manager",
                          subject: "[Autolab] Staff request",
                          class: "btn waves-effect waves-light" %>
            <% else %>
              <p class="red-text text-darken-2">
                Configure <code>instance_manager_email</code> in <code>config/school.yml</code> to enable this shortcut.
              </p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="row">
    <div class="col s12 m6">
      <div class="card contact-card">
        <div class="card-content">
          <span class="card-title">
            <i class="material-icons contact-icon">bug_report</i>
            Report a Bug or Request a Feature
          </span>
          <p>
            Help us keep Autolab healthy by reporting reproducible issues with as much detail as possible.
          </p>
          <ul class="contact-topics">
            <li>Steps to reproduce and expected behavior</li>
            <li>Relevant screenshots or stack traces</li>
            <li>Autograder logs or submission IDs</li>
          </ul>
        </div>
        <div class="card-action">
          <a class="btn-flat waves-effect contact-mailto" href="https://github.com/autolab/Autolab/issues" target="_blank" rel="noopener">
            <i class="material-icons left">open_in_new</i>
            Open GitHub Issues
          </a>
          <%= mail_to Rails.configuration.school['support_email'],
                      "Email support",
                      subject: "[Autolab] Issue report",
                      class: "btn-flat waves-effect contact-mailto" %>
        </div>
      </div>
    </div>

    <% if @show_dev_cta %>
      <div class="col s12 m6">
        <div class="card contact-card">
          <div class="card-content">
            <span class="card-title">
              <i class="material-icons contact-icon">memory</i>
              Instance Managers &amp; Dev Team
            </span>
            <p>
              Use this channel for escalations that affect your entire Autolab instance or require code changes.
            </p>
            <ul class="contact-topics">
              <li>Site-wide outages or severe performance drops</li>
              <li>Security disclosures</li>
              <li>Upgrades, migrations, or sponsor acknowledgements</li>
            </ul>
          </div>
          <div class="card-action">
            <%= mail_to @developer_email,
                        "Email Autolab Dev Team",
                        subject: "[Autolab] Instance escalation",
                        class: "btn waves-effect waves-light" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @show_sponsor_panel %>
    <div class="row">
      <div class="col s12">
        <div class="card contact-card">
          <div class="card-content">
            <span class="card-title">
              <i class="material-icons contact-icon">favorite</i>
              Sponsors &amp; Acknowledgements
            </span>
            <p>
              Celebrate the organizations that make your Autolab instance possible.
              Instance managers can keep sponsor information up to date and share logos or links.
            </p>
          </div>
          <div class="card-action">
            <%= link_to "Manage sponsors", home_sponsors_path, class: "btn-flat waves-effect" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
