<% @title = "Legacy Export" %>

<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "export" %>
<% end %>

<% content_for :javascripts do %>
  <%= javascript_include_tag "export_course" %>
<% end %>

<h2>Legacy Export</h2>

<div class="card-panel yellow lighten-4">
  <p style="margin: 0;">
    <strong>Warning:</strong> This export path is intended only for older Autolab installations.
    For normalized course archives, use <%= link_to "Export Course", export_course_path(@course) %>.
  </p>
</div>

<p id="export_description">Select fields to include in the export:</p>

<%= render partial: "exportForm" %>
