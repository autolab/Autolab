<% @title = "Import Course" %>

<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "export" %>
<% end %>

<% content_for :javascripts do %>
  <%= javascript_include_tag "export_course" %>
<% end %>

<h2>Import Course</h2>

<% if @pending.present? %>
  <p>
    Detected a new-format course export
    <% if @pending["version"].present? && @pending["version"] != "legacy" %>
      (version <%= @pending["version"] %>)
    <% end %>.
  </p>
  <p>
    Package:
    <strong><%= @pending["original_filename"] %></strong>
    <% if @pending["byte_size"].present? %>
      (<%= number_to_human_size(@pending["byte_size"].to_i) %>)
    <% end %>.
  </p>
<% end %>

<p>
  The course configuration is always imported. Select the users and assessments to include;
  submissions are imported only when both their user and assessment are selected. Existing users
  are matched by email. The selected instructor will be enrolled in the imported course, and a new
  account will be created if necessary.
</p>

<% if @pending.present? %>
  <%= form_tag complete_import_courses_path, method: :post, id: "course_import_form" do %>
    <%= hidden_field_tag :selection_submitted, "1" %>
    <div class="form-group">
      <%= label_tag :course_identifier, "New course identifier" %>
      <%= text_field_tag :course_identifier, params[:course_identifier], required: true,
                         pattern: "[A-Za-z0-9_-]+", class: "form-control" %>
      <small>This becomes the course URL identifier and must not already exist.</small>
    </div>

    <div class="form-group">
      <%= label_tag :instructor_email, "New instructor email" %>
      <%= email_field_tag :instructor_email, params[:instructor_email], required: true,
                          class: "form-control" %>
    </div>

    <% selection_submitted = params[:selection_submitted].present? %>
    <% selected_user_ids = Array(params[:user_ids]) %>
    <% selected_assessment_ids = Array(params[:assessment_ids]) %>

    <% if @import_users&.any? %>
      <section class="export-selection" data-export-selection>
        <div class="export-selection-header">
          <h3>Users</h3>
          <span class="export-selection-count" data-selection-count="users"></span>
        </div>
        <div class="export-selection-controls">
          <label class="export-search-label" for="import_user_search">Search users</label>
          <input type="search" id="import_user_search" class="export-search"
                 data-export-search="users" placeholder="Name or email" autocomplete="off">
          <button type="button" class="btn-flat" data-select-visible="users">Select visible</button>
          <button type="button" class="btn-flat" data-unselect-visible="users">Unselect visible</button>
        </div>
        <div class="export-selection-table-wrapper">
          <table class="prettyBorder export-selection-table" data-export-table="users">
            <thead>
              <tr>
                <th class="export-checkbox-column">
                  <label class="export-checkbox-label" title="Select visible users">
                    <input type="checkbox" data-select-all="users" aria-label="Select visible users">
                    <span></span>
                  </label>
                </th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
              </tr>
            </thead>
            <tbody>
              <% @import_users.each_with_index do |user, index| %>
                <tr class="export-selection-row" data-export-row="users">
                  <td class="export-checkbox-column">
                    <label class="export-checkbox-label">
                      <%= check_box_tag "user_ids[]", user.id,
                                        !selection_submitted || selected_user_ids.include?(user.id),
                                        class: "export-selection-checkbox export-user",
                                        id: "import_user_#{index}",
                                        data: { export_item: "users" } %>
                      <span></span>
                    </label>
                  </td>
                  <td><%= user.name %></td>
                  <td><%= user.email %></td>
                  <td><%= user.role %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% else %>
      <h3>Users</h3>
      <p>This package has no users.</p>
    <% end %>

    <% if @import_assessments&.any? %>
      <section class="export-selection" data-export-selection>
        <div class="export-selection-header">
          <h3>Assessments</h3>
          <span class="export-selection-count" data-selection-count="assessments"></span>
        </div>
        <div class="export-selection-controls">
          <label class="export-search-label" for="import_assessment_search">Search assessments</label>
          <input type="search" id="import_assessment_search" class="export-search"
                 data-export-search="assessments" placeholder="Name" autocomplete="off">
          <button type="button" class="btn-flat" data-select-visible="assessments">Select visible</button>
          <button type="button" class="btn-flat" data-unselect-visible="assessments">Unselect visible</button>
        </div>
        <div class="export-selection-table-wrapper">
          <table class="prettyBorder export-selection-table" data-export-table="assessments">
            <thead>
              <tr>
                <th class="export-checkbox-column">
                  <label class="export-checkbox-label" title="Select visible assessments">
                    <input type="checkbox" data-select-all="assessments"
                           aria-label="Select visible assessments">
                    <span></span>
                  </label>
                </th>
                <th>Assessment</th>
                <th>Identifier</th>
              </tr>
            </thead>
            <tbody>
              <% @import_assessments.each_with_index do |assessment, index| %>
                <tr class="export-selection-row" data-export-row="assessments">
                  <td class="export-checkbox-column">
                    <label class="export-checkbox-label">
                      <%= check_box_tag "assessment_ids[]", assessment.id,
                                        !selection_submitted || selected_assessment_ids.include?(assessment.id),
                                        class: "export-selection-checkbox export-assessment",
                                        id: "import_assessment_#{index}",
                                        data: { export_item: "assessments" } %>
                      <span></span>
                    </label>
                  </td>
                  <td><%= assessment.name %></td>
                  <td><%= assessment.email %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% else %>
      <h3>Assessments</h3>
      <p>This package has no assessments.</p>
    <% end %>

    <%= submit_tag "Import Course", class: "btn primary",
                   data: { confirm: "Import this course package?" } %>
  <% end %>
<% end %>

<p>
  <%= link_to "Back to create course", new_course_path %>
</p>
