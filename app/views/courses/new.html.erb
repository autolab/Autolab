<% @title = "Create New Course" %>

<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "https://cdn.datatables.net/v/dt/dt-3.1.2/sl-4.1.1/datatables.min.css" %>
  <%= stylesheet_link_tag "export" %>
<% end %>

<% content_for :javascripts do %>
  <%= javascript_include_tag "https://cdn.datatables.net/v/dt/dt-3.1.2/sl-4.1.1/datatables.min.js" %>
  <%= javascript_include_tag "course_transfer_selection" %>
  <%= javascript_include_tag "course_import" %>
<% end %>

<div class="row">
  <div class="col s12">
    <ul class="tabs">
      <li class="tab col s6"><a href="#new-course">Create New Course</a></li>
      <li class="tab col s6"><a href="#import-course">Import Course</a></li>
    </ul>
  </div>
  <div id="new-course" class="col s12">
    <%= render partial: 'create_new_course' %>
  </div>
  <div id="import-course" class="col s12">
    <%= render partial: 'import_new_course' %>
  </div>
</div>
