<% @title = "Selective Course Archive" %>

<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "export" %>
<% end %>

<% content_for :javascripts do %>
  <%= javascript_include_tag "course_transfer_selection" %>
<% end %>

<h2>Selective Course Archive</h2>
<p>
  The course configuration is always included. Select the users and assessments to include;
  submissions are exported only when both are selected.
</p>

<%= form_tag archive_course_path(@course), method: :post do %>
  <% users = @export_users.map do |membership|
       role = if membership.instructor?
                "Instructor"
              elsif membership.course_assistant?
                "Course Assistant (TA)"
              else
                "Student"
              end
       { id: membership.user_id, name: membership.user.display_name,
         email: membership.user.email, role: role }
     end %>
  <% assessments = @export_assessments.map do |assessment|
       { id: assessment.id, name: assessment.display_name, identifier: assessment.name }
     end %>

  <div data-course-transfer-selector="users" data-id-prefix="export">
    <script type="application/json"><%= raw json_escape(users.to_json) %></script>
  </div>
  <div data-course-transfer-selector="assessments" data-id-prefix="export">
    <script type="application/json"><%= raw json_escape(assessments.to_json) %></script>
  </div>

  <%= submit_tag "Create archive", class: "btn", data: { disable_with: false } %>
<% end %>
