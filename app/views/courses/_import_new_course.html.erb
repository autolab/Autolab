<h3>Create New Course from Tarball</h3>

<%= form_with url: import_courses_path, method: :post, builder: FormBuilderWithDateTimeInput do |f| %>
  <p>
    If you have an existing Autolab course export, upload the tarball to continue:
  </p>
  <ul>
    <li>
      1: Go into Manage Course in the existing Autolab course
    </li>
    <li>
      2: On the left sidebar, click “Export course”
    </li>
    <li>
      3: Export with the current export page, or use Legacy Export for older Autolab formats
    </li>
    <li>
      4: Upload the tarball here. You will be guided to the right import form for the package version.
    </li>
  </ul>
  <%= f.file_field :tarFile, required: true,
                             help_text: "This tarball should have come from Autolab, and contains course configuration data" %>

  <%= f.submit "Continue", { class: "btn primary" } %>
<% end %>
